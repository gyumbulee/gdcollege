APP_NAME="GD College Wase API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gdcollege
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Comma-separated list of frontend origins allowed to authenticate via
# Sanctum (SPA cookie auth) — the Next.js app's host(s) go here.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Comma-separated list of origins allowed to call the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Institution identity — backend mirror of frontend/src/config/institution.config.ts
# Kept here only for backend-rendered content (documents, emails, receipts).
# The single source of truth for the *frontend* remains institution.config.ts.
# ---------------------------------------------------------------------------
INSTITUTION_FORMAL_NAME="Goran Dutse College of General Studies Wase"
INSTITUTION_SHORT_NAME="GD College Wase"

# ---------------------------------------------------------------------------
# Payment gateway — provider left unset until configured; do not hardcode
# a specific gateway's credentials anywhere outside this file's real .env.
# ---------------------------------------------------------------------------
PAYMENT_DEFAULT_PROVIDER=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
