APP_NAME="Wase Rock College API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gdcollege
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Comma-separated list of frontend origins allowed to authenticate via
# Sanctum (SPA cookie auth) — the Next.js app's host(s) go here.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Comma-separated list of origins allowed to call the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Institution identity — seeds the institutions table's single row the
# first time it's accessed (see config/institution.php and
# Admin\InstitutionSettingsController::row()). After that, the name lives
# in the database and is edited at /admin/institution — these vars only
# matter for a fresh install. The frontend's own static fallback
# (institution.config.ts, used when the API is unreachable) is a
# separate file and isn't read from here.
# ---------------------------------------------------------------------------
INSTITUTION_FORMAL_NAME="Wase Rock College of General Studies Wase"
INSTITUTION_SHORT_NAME="Wase Rock College"

# ---------------------------------------------------------------------------
# Payment gateway — provider left unset until configured; do not hardcode
# a specific gateway's credentials anywhere outside this file's real .env.
# Defaults to the 'test' gateway (see config/payments.php) so the full
# pay -> verify flow can be demoed with no live processor at all.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=test
PAYMENT_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_WEBHOOK_HASH=
KORAPAY_SECRET_KEY=
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1
KORAPAY_WEBHOOK_URL=
INVOICE_NUMBER_FORMAT="INV/{session}/{seq}"
INVOICE_NUMBER_SEQUENCE_PADDING=6

# ---------------------------------------------------------------------------
# Institutional policy knobs — every one of these is a SAMPLE/DEMO value
# until the institution confirms the real figure/format (Master
# Implementation Brief §40: "Do not invent institutional policies").
# ---------------------------------------------------------------------------
ADMISSIONS_APPLICATION_NUMBER_FORMAT="APP/{session}/{seq}"
ADMISSIONS_APPLICATION_FEE_AMOUNT=2000
ADMISSIONS_APPLICATION_FEE_REQUIRED=true
STUDENTS_MATRIC_NUMBER_FORMAT="WRC/{session}/{seq}"
REGISTRATION_MIN_CREDITS=12
REGISTRATION_MAX_CREDITS=24
REGISTRATION_PASSING_GRADE_POINT=0.0

# ---------------------------------------------------------------------------
# File storage — every controller that stores an uploaded file (logo/
# banner, document templates, gallery photos, CMS images/downloads,
# applicant documents, helpdesk attachments) reads UPLOADS_DISK /
# PRIVATE_UPLOADS_DISK instead of a hardcoded disk name (see
# config/filesystems.php). Both default to the local "public"/"private"
# disks below — zero external dependencies for local dev/demo. Set
# either (or both) to "s3" plus the AWS_* vars to move that class of
# file to Amazon S3, with no code changes anywhere.
# ---------------------------------------------------------------------------
UPLOADS_DISK=public
PRIVATE_UPLOADS_DISK=private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
# Optional — only needed for a custom domain/CloudFront in front of the
# bucket. Leave unset to use the bucket's own S3 endpoint URL.
AWS_URL=
# Optional — only needed for an S3-compatible provider other than AWS
# (e.g. DigitalOcean Spaces, MinIO) or a VPC endpoint.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Frontend base URL — used to build the password-reset link (Phase 14).
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
